generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum FamilyRole {
  ADMIN
  MEMBER
}

enum MemberStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum Scope {
  PRIVATE
  FAMILY
}

enum CategoryType {
  EXPENSE
  TASK
  CONTRACT
}

enum TransactionKind {
  EXPENSE
  INCOME
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum BillingInterval {
  MONTHLY
  YEARLY
  QUARTERLY
  ONCE
  OTHER
}

enum ContractStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  DRAFT
}

enum RecurringTransactionStatus {
  ACTIVE
  PAUSED
}

enum RecurringTaskStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum RecurringTaskIntervalUnit {
  DAY
  MONTH
  YEAR
}

enum DocumentReferenceType {
  SYNOLOGY_HTTPS
  WEBDAV_HTTPS
  EXTERNAL_URL
  LOCAL_FILE
}

enum LinkedEntityType {
  EXPENSE
  TASK
  CONTRACT
  GENERAL
}

model User {
  id           String         @id @default(cuid())
  name         String         @unique
  passwordHash String
  status       UserStatus     @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  memberships  FamilyMember[]
  sessions     Session[]
  categories   Category[]
  expenses     Expense[]      @relation("ExpenseOwner")
  expenseLabels ExpenseLabel[]
  fuelExpenseSettings FuelExpenseSettings[]
  cars          Car[]          @relation("CarCreator")
  fuelEntries   FuelEntry[]    @relation("FuelEntryCreator")
  tasks         Task[]         @relation("TaskOwner")
  assignedTasks Task[]         @relation("TaskAssignee")
  contracts     Contract[]
  recurringTransactions RecurringTransaction[]
  recurringTasks RecurringTask[] @relation("RecurringTaskOwner")
  assignedRecurringTasks RecurringTask[] @relation("RecurringTaskAssignee")
  documents     DocumentReference[]
  createdDocumentRoots DocumentRoot[] @relation("DocumentRootCreator")
  documentRootAccesses DocumentRootAccess[]
  createdRecoveryKeys AdminRecoveryKey[] @relation("AdminRecoveryKeyCreator")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginAttempt {
  normalizedName String   @id
  failedCount    Int      @default(0)
  lockedUntil    DateTime?
  lastFailedAt   DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Family {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   FamilyMember[]
  categories Category[]
  expenses   Expense[]
  expenseLabels ExpenseLabel[]
  fuelExpenseSettings FuelExpenseSettings[]
  cars       Car[]
  fuelEntries FuelEntry[]
  tasks      Task[]
  contracts  Contract[]
  recurringTransactions RecurringTransaction[]
  recurringTasks RecurringTask[]
  documents  DocumentReference[]
  documentRoots DocumentRoot[]
  adminRecoveryKey AdminRecoveryKey?
}

model AdminRecoveryKey {
  id              String   @id @default(cuid())
  familyId        String   @unique
  keyHash         String
  createdByUserId String?
  lastUsedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  family          Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy       User?    @relation("AdminRecoveryKeyCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([createdByUserId])
}

model FamilyMember {
  id        String       @id @default(cuid())
  familyId  String
  userId    String
  role      FamilyRole   @default(MEMBER)
  status    MemberStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  family    Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([userId])
}

model Category {
  id          String       @id @default(cuid())
  familyId    String
  ownerUserId String?
  type        CategoryType
  name        String
  color       String       @default("#2f6fed")
  icon        String       @default("tag")
  monthlyBudgetCents Int   @default(0)
  scope       Scope        @default(FAMILY)
  family      Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  owner       User?        @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  expenses    Expense[]
  contractExpenseDefaults Contract[] @relation("ContractExpenseCategory")
  recurringTransactions RecurringTransaction[]
  fuelExpenseSettings FuelExpenseSettings[]

  @@index([familyId, type])
}

model ExpenseLabel {
  id          String   @id @default(cuid())
  familyId    String
  ownerUserId String
  name        String
  color       String   @default("#16776f")
  budgetCents Int      @default(0)
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  expenses    Expense[]
  contractExpenseDefaults Contract[] @relation("ContractExpenseLabel")
  recurringTransactions RecurringTransaction[]
  fuelExpenseSettings FuelExpenseSettings[]

  @@unique([ownerUserId, name])
  @@index([familyId, ownerUserId])
}

model Expense {
  id          String   @id @default(cuid())
  familyId    String
  ownerUserId String
  kind        TransactionKind @default(EXPENSE)
  amountCents Int
  currency    String   @default("EUR")
  date        DateTime
  paymentMethod String  @default("Nicht angegeben")
  store       String   @default("")
  categoryId  String?
  labelId     String?
  contractId  String?
  fuelEntryId String?  @unique
  recurringTransactionId String?
  generatedByContract Boolean @default(false)
  generatedByFuelEntry Boolean @default(false)
  generatedByRecurringTransaction Boolean @default(false)
  description String
  scope       Scope    @default(FAMILY)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  owner       User     @relation("ExpenseOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  label       ExpenseLabel? @relation(fields: [labelId], references: [id], onDelete: SetNull)
  contract    Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  fuelEntry   FuelEntry? @relation(fields: [fuelEntryId], references: [id], onDelete: SetNull)
  recurringTransaction RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)

  @@index([familyId, date])
  @@index([familyId, kind])
  @@index([ownerUserId])
  @@index([labelId])
  @@index([contractId])
  @@index([fuelEntryId])
  @@index([recurringTransactionId])
}

model FuelExpenseSettings {
  id                   String   @id @default(cuid())
  familyId             String
  userId               String
  autoCreateExpense    Boolean  @default(false)
  defaultCategoryId    String?
  defaultLabelId       String?
  defaultPaymentMethod String   @default("")
  defaultStore         String   @default("")
  defaultDescription   String   @default("")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  family               Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultCategory      Category? @relation(fields: [defaultCategoryId], references: [id], onDelete: SetNull)
  defaultLabel         ExpenseLabel? @relation(fields: [defaultLabelId], references: [id], onDelete: SetNull)

  @@unique([familyId, userId])
  @@index([defaultCategoryId])
  @@index([defaultLabelId])
}

model Car {
  id              String      @id @default(cuid())
  familyId        String
  createdByUserId String?
  name            String
  licensePlate    String      @default("")
  color           String      @default("#16776f")
  notes           String      @default("")
  archivedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  family          Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  creator         User?       @relation("CarCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  fuelEntries     FuelEntry[]

  @@index([familyId, archivedAt])
  @@index([createdByUserId])
}

model FuelEntry {
  id              String   @id @default(cuid())
  familyId        String
  carId           String
  createdByUserId String?
  date            DateTime
  odometerKm      Int
  litersMilli     Int
  costCents       Int
  note            String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  family          Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  car             Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  creator         User?    @relation("FuelEntryCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  expense         Expense?

  @@unique([carId, odometerKm])
  @@index([familyId, date])
  @@index([carId, date])
  @@index([createdByUserId])
}

model Task {
  id               String       @id @default(cuid())
  familyId         String
  ownerUserId      String
  assignedToUserId String?
  title            String
  description      String?
  status           TaskStatus   @default(OPEN)
  priority         TaskPriority @default(MEDIUM)
  dueDate          DateTime?
  recurringTaskId  String?
  recurringTaskDueDate DateTime?
  scope            Scope        @default(FAMILY)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  family           Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  owner            User         @relation("TaskOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  assignee         User?        @relation("TaskAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  recurringTask    RecurringTask? @relation(fields: [recurringTaskId], references: [id], onDelete: SetNull)

  @@index([familyId, status])
  @@index([assignedToUserId])
  @@index([recurringTaskId])
  @@unique([recurringTaskId, recurringTaskDueDate])
}

model RecurringTask {
  id               String                    @id @default(cuid())
  familyId         String
  ownerUserId      String
  assignedToUserId String?
  title            String
  description      String?
  priority         TaskPriority              @default(MEDIUM)
  scope            Scope                     @default(FAMILY)
  startDate        DateTime
  endDate          DateTime?
  intervalCount    Int                       @default(1)
  intervalUnit     RecurringTaskIntervalUnit @default(MONTH)
  leadTimeDays     Int
  nextDueDate      DateTime?
  status           RecurringTaskStatus       @default(ACTIVE)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  family           Family                    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  owner            User                      @relation("RecurringTaskOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  assignee         User?                     @relation("RecurringTaskAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  tasks            Task[]

  @@index([familyId, status, nextDueDate])
  @@index([ownerUserId])
  @@index([assignedToUserId])
}

model Contract {
  id                     String          @id @default(cuid())
  familyId               String
  ownerUserId            String
  provider               String
  contractType           String
  description            String?
  costCents              Int
  currency               String          @default("EUR")
  billingInterval        BillingInterval @default(MONTHLY)
  startDate              DateTime
  endDate                DateTime?
  cancellationNoticeDays Int?
  cancellationDeadlineMonth Int?
  cancellationDeadlineDay   Int?
  autoRenewal           Boolean         @default(false)
  renewalInterval       BillingInterval @default(MONTHLY)
  renewalAnchorDay      Int?
  autoCreateExpenses    Boolean         @default(false)
  expensePaymentDay     Int?
  expenseCategoryId     String?
  expenseLabelId        String?
  nextCancellationDate   DateTime?
  status                 ContractStatus  @default(ACTIVE)
  scope                  Scope           @default(FAMILY)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  family                 Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  owner                  User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  expenseCategory        Category?       @relation("ContractExpenseCategory", fields: [expenseCategoryId], references: [id], onDelete: SetNull)
  expenseLabel           ExpenseLabel?   @relation("ContractExpenseLabel", fields: [expenseLabelId], references: [id], onDelete: SetNull)
  expenses               Expense[]
  pricePhases            ContractPricePhase[]

  @@index([familyId, status])
  @@index([nextCancellationDate])
  @@index([expenseCategoryId])
  @@index([expenseLabelId])
}

model ContractPricePhase {
  id              String          @id @default(cuid())
  contractId      String
  amountCents     Int
  currency        String          @default("EUR")
  billingInterval BillingInterval @default(MONTHLY)
  validFrom       DateTime
  validTo         DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  contract        Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, validFrom])
}

model RecurringTransaction {
  id              String                     @id @default(cuid())
  familyId        String
  ownerUserId     String
  kind            TransactionKind            @default(EXPENSE)
  title           String
  description     String                     @default("")
  paymentMethod   String                     @default("Nicht angegeben")
  store           String                     @default("")
  categoryId      String?
  labelId         String?
  startDate       DateTime
  endDate         DateTime?
  nextDueDate     DateTime?
  status          RecurringTransactionStatus @default(ACTIVE)
  deletedAt       DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  family          Family                     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  owner           User                       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  category        Category?                  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  label           ExpenseLabel?              @relation(fields: [labelId], references: [id], onDelete: SetNull)
  pricePhases     RecurringTransactionPricePhase[]
  expenses        Expense[]

  @@index([familyId, ownerUserId, status])
  @@index([categoryId])
  @@index([labelId])
}

model RecurringTransactionPricePhase {
  id                     String               @id @default(cuid())
  recurringTransactionId String
  amountCents            Int
  currency               String               @default("EUR")
  billingInterval        BillingInterval      @default(MONTHLY)
  validFrom              DateTime
  validTo                DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  recurringTransaction   RecurringTransaction @relation(fields: [recurringTransactionId], references: [id], onDelete: Cascade)

  @@index([recurringTransactionId, validFrom])
}

model DocumentReference {
  id               String                @id @default(cuid())
  familyId         String
  ownerUserId      String
  documentRootId   String?
  linkedEntityType LinkedEntityType      @default(GENERAL)
  linkedEntityId   String?
  title            String
  referenceType    DocumentReferenceType
  url              String
  relativePath     String?
  fileName         String?
  mimeType         String?
  fileSize         Int?
  lastSeenAt       DateTime?
  description      String?
  scope            Scope                 @default(FAMILY)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  family           Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  owner            User                  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  documentRoot     DocumentRoot?         @relation(fields: [documentRootId], references: [id], onDelete: SetNull)

  @@index([familyId, linkedEntityType, linkedEntityId])
  @@index([documentRootId])
}

model DocumentRoot {
  id              String               @id @default(cuid())
  familyId        String
  name            String
  basePath        String
  scope           Scope                @default(FAMILY)
  createdByUserId String?
  archivedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  family          Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy       User?                @relation("DocumentRootCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  accesses        DocumentRootAccess[]
  documents       DocumentReference[]

  @@index([familyId, archivedAt])
  @@index([createdByUserId])
}

model DocumentRootAccess {
  id             String      @id @default(cuid())
  documentRootId String
  userId         String?
  role           FamilyRole?
  canRead        Boolean     @default(true)
  createdAt      DateTime    @default(now())
  documentRoot   DocumentRoot @relation(fields: [documentRootId], references: [id], onDelete: Cascade)
  user           User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentRootId])
  @@index([userId])
  @@unique([documentRootId, userId])
  @@unique([documentRootId, role])
}
