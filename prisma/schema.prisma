generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum FamilyRole {
  ADMIN
  MEMBER
}

enum MemberStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum Scope {
  PRIVATE
  FAMILY
}

enum CategoryType {
  EXPENSE
  TASK
  CONTRACT
}

enum TransactionKind {
  EXPENSE
  INCOME
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum BillingInterval {
  MONTHLY
  YEARLY
  QUARTERLY
  ONCE
  OTHER
}

enum ContractStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  DRAFT
}

enum DocumentReferenceType {
  SYNOLOGY_HTTPS
  WEBDAV_HTTPS
  EXTERNAL_URL
}

enum LinkedEntityType {
  EXPENSE
  TASK
  CONTRACT
  GENERAL
}

model User {
  id           String         @id @default(cuid())
  name         String         @unique
  passwordHash String
  status       UserStatus     @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  memberships  FamilyMember[]
  sessions     Session[]
  categories   Category[]
  expenses     Expense[]      @relation("ExpenseOwner")
  expenseLabels ExpenseLabel[]
  tasks         Task[]         @relation("TaskOwner")
  assignedTasks Task[]         @relation("TaskAssignee")
  contracts     Contract[]
  documents     DocumentReference[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginAttempt {
  normalizedName String   @id
  failedCount    Int      @default(0)
  lockedUntil    DateTime?
  lastFailedAt   DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Family {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   FamilyMember[]
  categories Category[]
  expenses   Expense[]
  expenseLabels ExpenseLabel[]
  tasks      Task[]
  contracts  Contract[]
  documents  DocumentReference[]
}

model FamilyMember {
  id        String       @id @default(cuid())
  familyId  String
  userId    String
  role      FamilyRole   @default(MEMBER)
  status    MemberStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  family    Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([userId])
}

model Category {
  id          String       @id @default(cuid())
  familyId    String
  ownerUserId String?
  type        CategoryType
  name        String
  color       String       @default("#2f6fed")
  icon        String       @default("tag")
  monthlyBudgetCents Int   @default(0)
  scope       Scope        @default(FAMILY)
  family      Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  owner       User?        @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  expenses    Expense[]

  @@index([familyId, type])
}

model ExpenseLabel {
  id          String   @id @default(cuid())
  familyId    String
  ownerUserId String
  name        String
  color       String   @default("#16776f")
  budgetCents Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  expenses    Expense[]

  @@unique([ownerUserId, name])
  @@index([familyId, ownerUserId])
}

model Expense {
  id          String   @id @default(cuid())
  familyId    String
  ownerUserId String
  kind        TransactionKind @default(EXPENSE)
  amountCents Int
  currency    String   @default("EUR")
  date        DateTime
  paymentMethod String  @default("Nicht angegeben")
  store       String   @default("")
  categoryId  String?
  labelId     String?
  contractId  String?
  description String
  scope       Scope    @default(FAMILY)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  owner       User     @relation("ExpenseOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  label       ExpenseLabel? @relation(fields: [labelId], references: [id], onDelete: SetNull)
  contract    Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([familyId, date])
  @@index([familyId, kind])
  @@index([ownerUserId])
  @@index([labelId])
  @@index([contractId])
}

model Task {
  id               String       @id @default(cuid())
  familyId         String
  ownerUserId      String
  assignedToUserId String?
  title            String
  description      String?
  status           TaskStatus   @default(OPEN)
  priority         TaskPriority @default(MEDIUM)
  dueDate          DateTime?
  scope            Scope        @default(FAMILY)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  family           Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  owner            User         @relation("TaskOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  assignee         User?        @relation("TaskAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([familyId, status])
  @@index([assignedToUserId])
}

model Contract {
  id                     String          @id @default(cuid())
  familyId               String
  ownerUserId            String
  provider               String
  contractType           String
  description            String?
  costCents              Int
  currency               String          @default("EUR")
  billingInterval        BillingInterval @default(MONTHLY)
  startDate              DateTime
  endDate                DateTime?
  cancellationNoticeDays Int?
  cancellationDeadlineMonth Int?
  cancellationDeadlineDay   Int?
  autoRenewal           Boolean         @default(false)
  renewalInterval       BillingInterval @default(MONTHLY)
  renewalAnchorDay      Int?
  nextCancellationDate   DateTime?
  status                 ContractStatus  @default(ACTIVE)
  scope                  Scope           @default(FAMILY)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  family                 Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  owner                  User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  expenses               Expense[]

  @@index([familyId, status])
  @@index([nextCancellationDate])
}

model DocumentReference {
  id               String                @id @default(cuid())
  familyId         String
  ownerUserId      String
  linkedEntityType LinkedEntityType      @default(GENERAL)
  linkedEntityId   String?
  title            String
  referenceType    DocumentReferenceType
  url              String
  description      String?
  scope            Scope                 @default(FAMILY)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  family           Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  owner            User                  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([familyId, linkedEntityType, linkedEntityId])
}
