DATABASE_URL="postgresql://family_app:change-me@localhost:5432/family_app?schema=public"
SESSION_COOKIE_NAME="family_app_session"
APP_URL="http://localhost:3000"
# 32+ random characters. Used to encrypt local CalDAV credentials before storing them in PostgreSQL.
CALENDAR_SECRET="change-this-to-a-long-random-local-secret"

# Microsoft Outlook / Graph calendar sync. Create an app registration and use:
# Redirect URI: http://localhost:3000/api/outlook/callback
# Permissions: User.Read, Calendars.Read, offline_access
OUTLOOK_CLIENT_ID=""
OUTLOOK_CLIENT_SECRET=""
OUTLOOK_TENANT="common"
OUTLOOK_REDIRECT_URI="http://localhost:3000/api/outlook/callback"
