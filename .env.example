DATABASE_URL="postgresql://family_app:change-me@localhost:5432/family_app?schema=public"
SESSION_COOKIE_NAME="family_app_session"
APP_URL="http://localhost:3000"
APP_PORT="3000"
POSTGRES_PASSWORD="change-this-to-a-long-random-database-password"

# Optional mounted CSV mirror for personal expenses.
# In Docker, mount a Synology folder to this path and keep the file name stable.
EXPENSE_CSV_DIR="./data/expenses"
EXPENSE_CSV_PATH="/data/expenses/expenses.csv"

# Docker backup service. On Synology, point BACKUP_DIR to a real shared folder.
BACKUP_DIR="./data/backups"
BACKUP_RETENTION_DAYS="30"
BACKUP_INTERVAL_SECONDS="86400"
