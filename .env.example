DATABASE_URL="postgresql://family_app:change-me@localhost:5432/family_app?schema=public"
SESSION_COOKIE_NAME="family_app_session"
APP_URL="http://localhost:3000"
APP_PORT="3000"
POSTGRES_PASSWORD="change-this-to-a-long-random-database-password"

# Optional mounted Excel folder for personal expense import/export.
# The host folder is mounted to EXPENSE_EXCEL_DIR inside the app container.
EXPENSE_EXCEL_HOST_DIR="./data/expenses"
EXPENSE_EXCEL_DIR="/data/expenses"

# Docker backup service. On Synology, point BACKUP_DIR to a real shared folder.
BACKUP_DIR="./data/backups"
BACKUP_RETENTION_DAYS="30"
BACKUP_INTERVAL_SECONDS="86400"
